{
  "name": "6oclock",
  "private": true,
  "description": "e6 staff dashboard",
  "license": "MIT",
  "author": "binaryfloof",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up -d --wait && concurrently -k -n api,web -c blue,magenta \"npm run api\" \"npm run web\"",
    "api": "npm run dev -w @6oclock/api",
    "web": "npm run dev -w @6oclock/web",
    "build:api": "npm run build -w @6oclock/api",
    "build:web": "npm run build -w @6oclock/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present"
  },
  "devDependencies": {
    "commander": "~14.0.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.10.0"
  },
  "overrides": {
    "typescript": "^6.0.3"
  }
}
