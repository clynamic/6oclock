# E621 API Configuration
# This is required. You can find your API key here: https://e621.net/api_keys
# The user account must have Moderator permissions or greater. Otherwise, moderation data sync will fail.
E621_GLOBAL_USERNAME=your_username_here
E621_GLOBAL_API_KEY=your_api_key_here

# PostgreSQL Database Configuration
# In dev, these point at the Postgres container published by compose.override.yml.
# In the full Docker setup, compose.yml sets these and this section is ignored.
DB_HOST=localhost
DB_PORT=34572
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=six_oclock

# Server Port
# PORT=34571

# Localhost is always allowed. Add your hosting domain here in production.
# CORS_ALLOWED_ORIGINS=

# Stores files like the session cipher key. Must be persistent.
# DATA_DIR=./data

# Comma-separated list of e621 user IDs that can administer the server.
# TECHNICIANS=

# e621 oauth appplication
# OIDC_ISSUER=https://e621.net
OIDC_CLIENT_ID=your_oauth_client_id
OIDC_CLIENT_SECRET=your_oauth_client_secret
OIDC_REDIRECT_URI=http://127.0.0.1:34571/api/auth/callback

# Where to send the browser after a successful login (the web app origin).
APP_POST_LOGIN_URL=http://127.0.0.1:47823

# Set to false in local http development so the session cookie is sent over http.
COOKIE_SECURE=false

# Development Settings
# Comment out or remove in production.
NODE_ENV=development
