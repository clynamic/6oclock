{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "testPathIgnorePatterns": ["\\.int\\.spec\\.ts$"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/../jest.global-setup.js",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/$1"
  }
}
